{
  "name": "weekly-work-board",
  "version": "1.1.2",
  "description": "WIP Board — Work In Progress Board",
  "main": "main.js",
  "author": "WorkBuddy",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.workbuddy.wipboard",
    "productName": "WIP Board",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "sign": false
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WIP Board"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "state.js",
      "storage.js",
      "board.js",
      "ai.js",
      "app.js",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  }
}
