{
  "name": "workinprogress",
  "version": "1.1.1",
  "description": "Work In Progress — 本周工作安排",
  "main": "main.js",
  "author": "WorkBuddy",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.workbuddy.wip",
    "productName": "Work In Progress",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "sign": "signHook.js"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WIP"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "state.js",
      "storage.js",
      "board.js",
      "ai.js",
      "app.js",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@tabler/icons": "^3.31.0"
  }
}
